node_modules/

# Runtime data. The editor writes a timestamped backup of services.yaml on every save,
# so this directory only accumulates local history. Pointing HOMEPAGE_BACKUP_PATH
# somewhere else takes the backups out of the repository, and then this rule no longer
# covers them.
backups/

# The editor's own settings (preview target, bind address). Like the Homepage config
# below, it describes one machine, so it stays out of version control.
cms-settings.yaml
.homepage-cms.yaml

# Your own homepage configuration. It lists internal hosts, container names and
# addresses, so it stays on the machine that runs the editor. The committed
# config/*.example.yaml files show the expected shape.
config/services.yaml
config/bookmarks.yaml

# The editor's own settings file (preview target). Machine-specific, like the
# configuration above.
config/.homepage-cms.yaml

# Generated by tests/shots-visible.mjs
shots/

# ==== 開發工具：各自的安裝產物，不進版控 =================================
# 這些是工具產物，不是專案原始碼。各工具更新時都會整份覆寫，提交進來只會製造
# 大 diff，而且會把別人的開發偏好綁進這個倉庫。倉庫只留專案本體與規格。
#   gitnexus      : npm i -g gitnexus@latest && gitnexus analyze --index-only
#   ui-ux-pro-max : npm i -g ui-ux-pro-max-cli@latest && uipro init --ai codex
#   openspec      : npm i -g @fission-ai/openspec@latest && openspec init
.agents/
.claude/

# Local GitNexus knowledge graph. Rebuilt by `gitnexus analyze`; never committed.
.gitnexus/

*.log
.env
.DS_Store
Thumbs.db
